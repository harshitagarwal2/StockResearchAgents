{
  "schema_version": "host-adapters.v1",
  "runtime": "installed_python_package",
  "workflow_profile": "company-analytics.v1",
  "default_execution_mode": "compatible",
  "canonical_skill": "skills/tradingagents-portable/SKILL.md",
  "servers": {
    "coordination": {
      "server_id": "tradingagents-portable",
      "transport": "stdio",
      "installed_command": "stock-research-agents-mcp",
      "source_launcher": "scripts/run-stock-research-mcp"
    },
    "research_data": {
      "server_id": "tradingagents-research-data",
      "transport": "stdio",
      "installed_command": "stock-research-data-mcp",
      "source_launcher": "scripts/run-stock-research-data-mcp"
    }
  },
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "templates": {
    "claude_code": "claude-code/.mcp.json",
    "opencode": "opencode/opencode.json",
    "hermes_agent": "hermes/config.yaml"
  }
}
