{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-research-agents.local/schemas/source-lineage-crosswalk.v1.json",
  "title": "Provider-neutral inward source lineage crosswalk v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "source-lineage-crosswalk.v1"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/sourceLineageBinding"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publicUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "sourceLineageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "source_batch_id",
        "source_observation_id",
        "content_sha256_scope",
        "content_sha256",
        "canonical_uri",
        "license_receipt_id",
        "dossier_document_id",
        "analytics_source_id",
        "analytics_license_receipt_id",
        "entitlement_access",
        "redistributable",
        "terms_uri"
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "source_batch_id": {"$ref": "#/$defs/id"},
        "source_observation_id": {"$ref": "#/$defs/id"},
        "content_sha256_scope": {"enum": ["source_content", "bounded_extract", "normalized_source_record"]},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "canonical_uri": {"$ref": "#/$defs/publicUri"},
        "license_receipt_id": {"$ref": "#/$defs/id"},
        "dossier_document_id": {"$ref": "#/$defs/id"},
        "analytics_source_id": {"$ref": "#/$defs/id"},
        "analytics_license_receipt_id": {"$ref": "#/$defs/id"},
        "entitlement_access": {"enum": ["public", "licensed", "entitlement_blocked"]},
        "redistributable": {"type": "boolean"},
        "terms_uri": {"oneOf": [{"$ref": "#/$defs/publicUri"}, {"type": "null"}]}
      }
    }
  }
}
