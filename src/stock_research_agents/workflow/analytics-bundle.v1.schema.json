{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-research-agents.local/schemas/analytics-bundle.v1.json",
  "title": "Deterministic analytics bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "base_submission_digest", "base_dossier_digest", "cutoff_at", "completed_at",
    "facts", "statement_snapshots", "restatements", "ratios", "calculation_receipts",
    "dcf_models", "dcf_valuations", "reverse_dcf_results", "comparable_observations",
    "comparable_valuations", "analyst_opinions", "estimates", "consensus", "ownership",
    "insider_transactions", "short_interest", "datasets", "splits", "factors", "experiment_specs",
    "experiments", "catalysts", "event_clusters", "source_licenses", "coverage_decision",
    "limitations", "complete"
  ],
  "properties": {
    "run_id": {"$ref": "#/$defs/id"},
    "base_submission_digest": {"$ref": "#/$defs/digest"},
    "base_dossier_digest": {"$ref": "#/$defs/digest"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "facts": {"$ref": "#/$defs/records"},
    "statement_snapshots": {"$ref": "#/$defs/records"},
    "restatements": {"$ref": "#/$defs/records"},
    "ratios": {"$ref": "#/$defs/records"},
    "calculation_receipts": {"$ref": "#/$defs/records"},
    "dcf_models": {"$ref": "#/$defs/records"},
    "dcf_valuations": {"$ref": "#/$defs/records"},
    "reverse_dcf_results": {"$ref": "#/$defs/records"},
    "comparable_observations": {"$ref": "#/$defs/records"},
    "comparable_valuations": {"$ref": "#/$defs/records"},
    "analyst_opinions": {"$ref": "#/$defs/records"},
    "estimates": {"$ref": "#/$defs/records"},
    "consensus": {"$ref": "#/$defs/records"},
    "ownership": {"$ref": "#/$defs/records"},
    "insider_transactions": {"$ref": "#/$defs/records"},
    "short_interest": {"$ref": "#/$defs/records"},
    "datasets": {"$ref": "#/$defs/records"},
    "splits": {"$ref": "#/$defs/records"},
    "factors": {"$ref": "#/$defs/records"},
    "experiment_specs": {"$ref": "#/$defs/records"},
    "experiments": {"$ref": "#/$defs/records"},
    "catalysts": {"$ref": "#/$defs/records"},
    "event_clusters": {"$ref": "#/$defs/records"},
    "source_licenses": {"$ref": "#/$defs/records"},
    "coverage_decision": {"enum": ["supported", "insufficient_evidence", "conflicted", "policy_blocked"]},
    "limitations": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 1000}},
    "complete": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records": {"type": "array", "maxItems": 512, "items": {"type": "object"}}
  }
}
