{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingrearchagents.local/schemas/host-submission.v2.json",
  "title": "tradingrearchagents host-native submission v2",
  "description": "Credential-free completed research contract with distinct Research Manager, Trader, and Portfolio Manager semantics. Point-in-time cutoff, cross-reference, final-rating, and non-execution rules are additionally enforced by import_host_run.",
  "$ref": "#/$defs/submission",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "symbol", "as_of_date", "asset_type", "analysts", "debate_rounds", "risk_rounds", "output_language", "executor", "checkpoint_enabled"],
      "properties": {
        "schema_version": {"type": "string", "const": "2026-08-03"},
        "symbol": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._\\-^=]+$"},
        "as_of_date": {"type": "string", "format": "date"},
        "asset_type": {"enum": ["stock", "crypto"]},
        "analysts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["market", "social", "news", "fundamentals"]}
        },
        "debate_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
        "risk_rounds": {"type": "integer", "minimum": 1, "maximum": 10},
        "output_language": {"type": "string", "minLength": 1, "maxLength": 64},
        "executor": {"const": "host_native"},
        "checkpoint_enabled": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_type", "source_uri", "retrieved_at", "source_date"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_date": {"type": "string", "format": "date"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "summary", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "values": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "analystStageReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "evidence_ids", "confidence", "content"],
      "properties": {
        "thesis": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "analystReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyst", "thesis", "evidence_ids", "confidence", "content"],
      "properties": {
        "analyst": {"enum": ["market", "social", "news", "fundamentals"]},
        "thesis": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "analystStageOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "report"],
      "properties": {
        "company_of_interest": {"type": "string", "minLength": 1},
        "instrument_context": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "report": {"$ref": "#/$defs/analystStageReport"}
      }
    },
    "debateStageOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "evidence_ids"],
      "properties": {
        "position": {"type": "string", "minLength": 1},
        "responds_to": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "debateTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "speaker", "position", "evidence_ids"],
      "properties": {
        "round": {"type": "integer", "minimum": 1, "maximum": 10},
        "speaker": {"enum": ["Bull Researcher", "Bear Researcher", "Aggressive Analyst", "Conservative Analyst", "Neutral Analyst"]},
        "position": {"type": "string", "minLength": 1},
        "responds_to": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "researchManagerOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "rationale", "strategic_actions", "confidence"],
      "properties": {
        "recommendation": {"enum": ["Buy", "Overweight", "Hold", "Underweight", "Sell"]},
        "rationale": {"type": "string", "minLength": 1},
        "strategic_actions": {"type": "string", "minLength": 1},
        "raw_markdown": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "traderOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reasoning"],
      "properties": {
        "action": {"enum": ["Buy", "Hold", "Sell"]},
        "reasoning": {"type": "string", "minLength": 1},
        "entry_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "stop_loss": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "position_sizing": {"type": ["string", "null"], "minLength": 1},
        "raw_markdown": {"type": "string", "minLength": 1},
        "caveats": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "executable": {"const": false},
        "execution_authority": {"const": "none"},
        "submitted": {"const": false}
      }
    },
    "riskDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_level", "constraints", "unresolved"],
      "properties": {
        "risk_level": {"enum": ["low", "moderate", "high", "unknown"]},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "portfolioDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "executive_summary", "investment_thesis"],
      "properties": {
        "rating": {"enum": ["Buy", "Overweight", "Hold", "Underweight", "Sell"]},
        "executive_summary": {"type": "string", "minLength": 1},
        "investment_thesis": {"type": "string", "minLength": 1},
        "price_target": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "time_horizon": {"type": ["string", "null"], "minLength": 1},
        "raw_markdown": {"type": "string", "minLength": 1},
        "executable": {"const": false},
        "execution_authority": {"const": "none"},
        "submitted": {"const": false}
      }
    },
    "portfolioStageOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_decision", "portfolio_decision", "final_trade_decision"],
      "properties": {
        "risk_decision": {"$ref": "#/$defs/riskDecision"},
        "portfolio_decision": {"$ref": "#/$defs/portfolioDecision"},
        "final_trade_decision": {"type": "string", "minLength": 1},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "evidence", "analyst_reports", "research_debate", "research_decision", "trader_decision", "risk_debate", "risk_decision", "portfolio_decision", "final_trade_decision"],
      "properties": {
        "request": {"$ref": "#/$defs/request"},
        "company_of_interest": {"type": "string", "minLength": 1},
        "instrument_context": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "analyst_reports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/analystReport"}},
        "research_debate": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/debateTurn"}},
        "research_decision": {"$ref": "#/$defs/researchManagerOutput"},
        "trader_decision": {"$ref": "#/$defs/traderOutput"},
        "risk_debate": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/debateTurn"}},
        "risk_decision": {"$ref": "#/$defs/riskDecision"},
        "portfolio_decision": {"$ref": "#/$defs/portfolioDecision"},
        "final_trade_decision": {"type": "string", "minLength": 1},
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
