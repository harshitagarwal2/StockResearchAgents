{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagents-portable.local/schemas/research-lab.v1.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "status", "started_at", "completed_at", "input_digest", "output_digest", "attempts", "limitation"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["completed", "skipped", "blocked"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "output_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 100},
        "limitation": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "stageCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "envelope_digest", "receipt_digest"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "envelope_digest": {"$ref": "#/$defs/digest"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "runCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "profile", "research_pack_id", "submission_digest", "workflow_digest", "harness", "execution_mode", "started_at", "completed_at", "stages", "source_batch_ids", "artifact_kinds", "limitations", "complete"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "profile": {"$ref": "#/$defs/id"},
        "research_pack_id": {"$ref": "#/$defs/id"},
        "submission_digest": {"$ref": "#/$defs/digest"},
        "workflow_digest": {"$ref": "#/$defs/digest"},
        "harness": {"type": "string", "minLength": 1, "maxLength": 128},
        "execution_mode": {"enum": ["full", "compatible", "tools_only", "replay", "fixture"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "stages": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/stageReceipt"}},
        "source_batch_ids": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/id"}},
        "artifact_kinds": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/id"}},
        "limitations": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 1000}},
        "coordinator_commitments": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/stageCommitment"}},
        "complete": {"const": true}
      }
    },
    "hypothesisLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "hypothesis", "transitions", "final_status"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "hypothesis": {"type": "object"},
        "transitions": {"type": "array", "maxItems": 512, "items": {"type": "object"}},
        "final_status": {"enum": ["proposed", "supported", "weakened", "refuted", "inconclusive"]}
      }
    },
    "researchIteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration_id", "run_id", "hypothesis_ids", "started_at", "completed_at", "budget_units", "consumed_units", "novelty_score", "maximum_correlation", "decision", "output_digest"],
      "properties": {
        "iteration_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "hypothesis_ids": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/id"}},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "budget_units": {"type": "integer", "minimum": 1},
        "consumed_units": {"type": "integer", "minimum": 0},
        "novelty_score": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_correlation": {"type": "number", "minimum": 0, "maximum": 1},
        "decision": {"enum": ["continue", "stop_sufficient", "stop_budget", "stop_no_novelty", "stop_policy"]},
        "output_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
