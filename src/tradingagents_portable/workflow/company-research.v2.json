{
  "schema_version": "2.0.0",
  "id": "tradingagents.company-research.v2",
  "name": "Evidence-first point-in-time company research",
  "terminal_artifact_kind": "research_dossier.v3",
  "contracts": {
    "host_submission_schema": "host-submission.v3.schema.json",
    "request": "host-submission.v3.schema.json#/$defs/request",
    "research_plan": "host-submission.v3.schema.json#/$defs/researchPlan",
    "source_document": "host-submission.v3.schema.json#/$defs/document",
    "metric": "host-submission.v3.schema.json#/$defs/metric",
    "claim": "host-submission.v3.schema.json#/$defs/claim",
    "calculation": "host-submission.v3.schema.json#/$defs/calculation",
    "dossier": "host-submission.v3.schema.json#/$defs/dossier",
    "terminal": "host-submission.v3.schema.json#/$defs/hostSubmission"
  },
  "portable_boundary": {
    "host_owns": ["model_reasoning", "retrieval", "provider_credentials", "native_agent_execution", "entitlement_checks"],
    "portable_core_owns": ["typed_contracts", "point_in_time_validation", "referential_integrity", "deterministic_calculation_receipts", "bounded_publication"],
    "forbidden": ["credentials", "broker_or_order_execution", "raw_source_content", "silent_provider_fallback", "fabricated_completeness"]
  },
  "stages": [
    {"ordinal": 1, "id": "research.plan", "depends_on": [], "capabilities": ["adaptive_planning"], "output_refs": ["host-submission.v3.schema.json#/$defs/researchPlan"]},
    {"ordinal": 2, "id": "evidence.official", "depends_on": ["research.plan"], "capabilities": ["official_filings", "investor_relations", "exact_availability"], "output_refs": ["host-submission.v3.schema.json#/$defs/document", "host-submission.v3.schema.json#/$defs/filing"]},
    {"ordinal": 3, "id": "evidence.market", "depends_on": ["research.plan"], "capabilities": ["market_history", "latest_session_check"], "output_refs": ["host-submission.v3.schema.json#/$defs/document", "host-submission.v3.schema.json#/$defs/metric"]},
    {"ordinal": 4, "id": "analysis.financial", "depends_on": ["evidence.official"], "capabilities": ["filing_analysis", "guidance", "earnings_transcripts"], "output_refs": ["host-submission.v3.schema.json#/$defs/metric", "host-submission.v3.schema.json#/$defs/claim", "host-submission.v3.schema.json#/$defs/guidance", "host-submission.v3.schema.json#/$defs/transcript"]},
    {"ordinal": 5, "id": "analysis.company", "depends_on": ["evidence.official", "evidence.market"], "capabilities": ["events", "peers", "factors"], "output_refs": ["host-submission.v3.schema.json#/$defs/event", "host-submission.v3.schema.json#/$defs/peer", "host-submission.v3.schema.json#/$defs/factor"]},
    {"ordinal": 6, "id": "audit.evidence", "depends_on": ["analysis.financial", "analysis.company"], "capabilities": ["claim_grounding", "counterevidence", "coverage_audit", "temporal_audit"], "output_refs": ["host-submission.v3.schema.json#/$defs/claim", "host-submission.v3.schema.json#/$defs/coverage"]},
    {"ordinal": 7, "id": "verify.numerical", "depends_on": ["audit.evidence"], "capabilities": ["deterministic_recalculation", "unit_period_reconciliation"], "output_refs": ["host-submission.v3.schema.json#/$defs/calculation", "host-submission.v3.schema.json#/$defs/metric"]},
    {"ordinal": 8, "id": "debate.bull", "depends_on": ["verify.numerical"], "capabilities": ["constrained_debate"], "output_refs": ["host-submission.v3.schema.json#/$defs/claim"]},
    {"ordinal": 9, "id": "debate.bear", "depends_on": ["debate.bull"], "capabilities": ["counterclaim", "counterevidence"], "output_refs": ["host-submission.v3.schema.json#/$defs/claim"]},
    {"ordinal": 10, "id": "synthesis.valuation", "depends_on": ["debate.bear"], "capabilities": ["scenario_valuation"], "output_refs": ["host-submission.v3.schema.json#/$defs/valuation"]},
    {"ordinal": 11, "id": "synthesis.risk", "depends_on": ["synthesis.valuation"], "capabilities": ["risk_scenarios", "portfolio_context_sanitization"], "output_refs": ["host-submission.v3.schema.json#/$defs/risk", "host-submission.v3.schema.json#/$defs/portfolioContext"]},
    {"ordinal": 12, "id": "research.delta", "depends_on": ["synthesis.risk"], "capabilities": ["point_in_time_memory", "research_delta"], "output_refs": ["host-submission.v3.schema.json#/$defs/researchDelta"]},
    {"ordinal": 13, "id": "research.monitor", "depends_on": ["research.delta"], "capabilities": ["monitoring_conditions"], "output_refs": ["host-submission.v3.schema.json#/$defs/monitoring"]},
    {"ordinal": 14, "id": "evaluate.final", "depends_on": ["research.monitor"], "capabilities": ["evidence_audit", "numerical_verification", "temporal_audit", "completeness"], "output_refs": ["host-submission.v3.schema.json#/$defs/evaluation", "host-submission.v3.schema.json#/$defs/coverage"]},
    {"ordinal": 15, "id": "publish.dossier", "depends_on": ["evaluate.final"], "capabilities": ["atomic_completed_publication"], "output_refs": ["host-submission.v3.schema.json#/$defs/hostSubmission"]}
  ],
  "routing_semantics": {
    "execution": "Host harness executes ordered stages and returns only schema-valid bounded outputs.",
    "retrieval": "No provider is implicit; entitlement-blocked and unavailable sources remain explicit coverage states.",
    "calculation": "Portable code verifies deterministic receipts; model prose cannot substitute for arithmetic.",
    "publication": "publish.dossier is terminal and completed-only; partial state is never a research_dossier.v3 artifact."
  },
  "fallback": "sequential"
}
