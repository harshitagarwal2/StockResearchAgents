{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagents-portable.local/schemas/host-submission.v4.json",
  "title": "TradingAgents completed company analytics submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "company_research",
    "analytics_bundle",
    "source_lineage",
    "run_card",
    "hypothesis_ledgers",
    "research_iterations",
    "quality_receipt",
    "forecasts"
  ],
  "properties": {
    "schema_version": {"const": "company-analytics.v1"},
    "workflow_id": {"const": "tradingagents.company-analytics.v1"},
    "company_research": {"$ref": "host-submission.v3.schema.json#/$defs/hostSubmission"},
    "analytics_bundle": {"$ref": "analytics-bundle.v1.schema.json"},
    "source_lineage": {"$ref": "source-lineage-crosswalk.v1.schema.json"},
    "run_card": {"$ref": "research-lab.v1.schema.json#/$defs/runCard"},
    "hypothesis_ledgers": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "research-lab.v1.schema.json#/$defs/hypothesisLedger"}
    },
    "research_iterations": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "research-lab.v1.schema.json#/$defs/researchIteration"}
    },
    "quality_receipt": {"$ref": "research-quality.v1.schema.json#/$defs/receipt"},
    "forecasts": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "research-quality.v1.schema.json#/$defs/forecast"}
    }
  }
}
