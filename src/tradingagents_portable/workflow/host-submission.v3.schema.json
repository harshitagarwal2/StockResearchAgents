{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradingagents-portable.local/schemas/host-submission.v3.json",
  "title": "TradingAgents Portable completed company research submission v3",
  "description": "Credential-free, non-executable, bounded terminal company-research dossier. Cross-reference and point-in-time invariants are enforced by parse_host_submission_v3.",
  "$ref": "#/$defs/hostSubmission",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "T.*(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idArray": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["instrument_id", "symbol", "issuer_name", "asset_type", "exchange", "currency", "country", "cik"],
      "properties": {
        "instrument_id": {"$ref": "#/$defs/id"}, "symbol": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9^][A-Za-z0-9._^=/\\-]{0,31}$"},
        "issuer_name": {"type": "string", "minLength": 1, "maxLength": 256}, "asset_type": {"enum": ["equity", "fund", "crypto"]},
        "exchange": {"type": ["string", "null"]}, "currency": {"type": "string", "minLength": 1},
        "country": {"type": ["string", "null"]}, "cik": {"type": ["string", "null"], "pattern": "^[0-9]{10}$"}
      }
    },
    "portfolioContext": {
      "type": "object", "additionalProperties": false,
      "required": ["objective", "horizon", "risk_tolerance", "sector_exposure_percent", "issuer_exposure_percent", "constraints", "non_executable"],
      "properties": {
        "objective": {"type": "string", "minLength": 1}, "horizon": {"type": "string", "minLength": 1},
        "risk_tolerance": {"enum": ["low", "moderate", "high", "unspecified"]},
        "sector_exposure_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "issuer_exposure_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "constraints": {"type": "array", "maxItems": 512, "items": {"type": "string"}}, "non_executable": {"const": true}
      }
    },
    "researchObjective": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "decision_relevance", "required_claim_kinds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "decision_relevance": {"type": "string", "minLength": 1, "maxLength": 2000},
        "required_claim_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fact", "guidance", "estimate", "inference", "thesis"]}}
      }
    },
    "coverageDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["area", "required", "minimum_source_count", "preferred_source_kinds", "entitlement_policy"],
      "properties": {
        "area": {"type": "string", "minLength": 1, "maxLength": 128}, "required": {"type": "boolean"},
        "minimum_source_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "preferred_source_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["filing", "earnings_release", "transcript", "company", "regulatory", "market", "news", "other"]}},
        "entitlement_policy": {"enum": ["public_only", "host_entitled_allowed"]}
      }
    },
    "historyWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["area", "start_at", "end_at", "minimum_periods", "expansion_reasons", "latest_data_checks", "stop_conditions"],
      "properties": {
        "area": {"type": "string", "minLength": 1, "maxLength": 128}, "start_at": {"$ref": "#/$defs/timestamp"}, "end_at": {"$ref": "#/$defs/timestamp"},
        "minimum_periods": {"type": "integer", "minimum": 1, "maximum": 120},
        "expansion_reasons": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1}},
        "latest_data_checks": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1}},
        "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1}}
      }
    },
    "researchPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["objectives", "coverage_dimensions", "history_windows", "latest_data_checks", "stop_conditions"],
      "properties": {
        "objectives": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/researchObjective"}},
        "coverage_dimensions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/coverageDimension"}},
        "history_windows": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/historyWindow"}},
        "latest_data_checks": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1}},
        "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string", "minLength": 1}}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "requested_at", "cutoff_at", "research_mode", "identity", "research_plan", "output_language", "portfolio_context", "non_executable"],
      "properties": {
        "schema_version": {"const": "2026-08-03.v3"}, "request_id": {"$ref": "#/$defs/id"},
        "requested_at": {"$ref": "#/$defs/timestamp"}, "cutoff_at": {"$ref": "#/$defs/timestamp"},
        "research_mode": {"enum": ["live", "fixture", "historical_replay"]},
        "identity": {"$ref": "#/$defs/identity"},
        "research_plan": {"$ref": "#/$defs/researchPlan"},
        "output_language": {"type": "string", "minLength": 1, "maxLength": 64},
        "portfolio_context": {"oneOf": [{"$ref": "#/$defs/portfolioContext"}, {"type": "null"}]}, "non_executable": {"const": true}
      }
    },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "published_at", "available_at", "retrieved_at", "cutoff_at"],
      "properties": {
        "observed_at": {"$ref": "#/$defs/timestamp"}, "published_at": {"$ref": "#/$defs/timestamp"},
        "available_at": {"$ref": "#/$defs/timestamp"}, "retrieved_at": {"$ref": "#/$defs/timestamp"}, "cutoff_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "entitlement": {
      "type": "object", "additionalProperties": false,
      "required": ["access", "redistributable", "terms_uri", "limitation"],
      "properties": {
        "access": {"enum": ["public", "licensed", "entitlement_blocked"]}, "redistributable": {"type": "boolean"},
        "terms_uri": {"type": ["string", "null"], "format": "uri", "pattern": "^https://", "maxLength": 2048}, "limitation": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"access": {"const": "entitlement_blocked"}}, "required": ["access"]},
          "then": {
            "properties": {
              "redistributable": {"const": false},
              "limitation": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_uri", "document_id", "accession_number", "content_sha256"],
      "properties": {
        "canonical_uri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
        "document_id": {"type": ["string", "null"]}, "accession_number": {"type": ["string", "null"]}, "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "publisher", "locator", "entitlement", "temporal", "extract"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["filing", "earnings_release", "transcript", "company", "regulatory", "market", "news", "other"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 512}, "publisher": {"type": "string", "minLength": 1, "maxLength": 256},
        "locator": {"$ref": "#/$defs/locator"}, "entitlement": {"$ref": "#/$defs/entitlement"}, "temporal": {"$ref": "#/$defs/temporal"},
        "extract": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entitlement": {
                "properties": {"redistributable": {"const": false}},
                "required": ["redistributable"]
              }
            },
            "required": ["entitlement"]
          },
          "then": {"properties": {"extract": {"type": "null"}}}
        }
      ]
    },
    "calculation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "formula", "operation", "input_metric_ids", "constants", "result", "unit", "engine", "rounding_digits", "tolerance", "deterministic"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "formula": {"type": "string", "minLength": 1, "maxLength": 2000},
        "operation": {"enum": ["add", "subtract", "multiply", "divide", "sum", "average", "identity", "discounted_cash_flow"]},
        "input_metric_ids": {"$ref": "#/$defs/idArray"},
        "constants": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"$ref": "#/$defs/id"}, "value": {"type": "number"}}}},
        "result": {"type": "number"}, "unit": {"type": "string"}, "engine": {"type": "string", "minLength": 1, "maxLength": 128},
        "rounding_digits": {"type": ["integer", "null"], "minimum": 0, "maximum": 12}, "tolerance": {"type": "number", "minimum": 0, "maximum": 1}, "deterministic": {"const": true}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "value", "unit", "period_start", "period_end", "as_of_at", "basis", "source_document_ids", "calculation_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string"},
        "period_start": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "period_end": {"$ref": "#/$defs/timestamp"}, "as_of_at": {"$ref": "#/$defs/timestamp"},
        "basis": {"enum": ["reported", "calculated", "estimated", "assumption"]}, "source_document_ids": {"$ref": "#/$defs/idArray"},
        "calculation_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "kind", "stance", "evidence_document_ids", "metric_ids", "counterevidence_document_ids", "counterclaim_ids", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 8000},
        "kind": {"enum": ["fact", "guidance", "estimate", "inference", "thesis"]}, "stance": {"enum": ["bull", "bear", "neutral"]},
        "evidence_document_ids": {"$ref": "#/$defs/idArray"}, "metric_ids": {"$ref": "#/$defs/idArray"},
        "counterevidence_document_ids": {"$ref": "#/$defs/idArray"}, "counterclaim_ids": {"$ref": "#/$defs/idArray"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "argument": {
      "type": "object", "additionalProperties": false,
      "required": ["argument_id", "debate", "round", "turn", "role", "claim_ids", "assumption_ids", "rebuttal_of", "concessions", "unresolved"],
      "properties": {"argument_id": {"$ref": "#/$defs/id"}, "debate": {"enum": ["research", "risk"]}, "round": {"type": "integer", "minimum": 1}, "turn": {"type": "integer", "minimum": 1}, "role": {"type": "string", "minLength": 1, "maxLength": 128}, "claim_ids": {"$ref": "#/$defs/idArray"}, "assumption_ids": {"$ref": "#/$defs/idArray"}, "rebuttal_of": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "concessions": {"type": "array", "maxItems": 512, "items": {"type": "string"}}, "unresolved": {"type": "array", "maxItems": 512, "items": {"type": "string"}}}
    },
    "filing": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "form", "accession_number", "filed_at", "period_end", "document_id", "amendment"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "form": {"type": "string"}, "accession_number": {"type": "string"}, "filed_at": {"$ref": "#/$defs/timestamp"}, "period_end": {"$ref": "#/$defs/timestamp"}, "document_id": {"$ref": "#/$defs/id"}, "amendment": {"type": "boolean"}}
    },
    "filingChange": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "prior_document_id", "current_document_id", "change_kind", "summary", "metric_ids", "claim_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "prior_document_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "current_document_id": {"$ref": "#/$defs/id"}, "change_kind": {"enum": ["narrative", "table", "risk", "mda", "accounting"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "metric_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}}
    },
    "transcriptSegment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "section", "speaker", "extract", "claim_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "section": {"enum": ["prepared", "qa"]}, "speaker": {"type": "string", "minLength": 1, "maxLength": 256}, "extract": {"type": "string", "minLength": 1, "maxLength": 2000}, "claim_ids": {"$ref": "#/$defs/idArray"}}
    },
    "transcriptTheme": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "segment_ids", "claim_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "segment_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}}
    },
    "transcript": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "event_at", "document_id", "speaker_summary", "guidance_claim_ids", "segments", "themes"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "event_at": {"$ref": "#/$defs/timestamp"}, "document_id": {"$ref": "#/$defs/id"}, "speaker_summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "guidance_claim_ids": {"$ref": "#/$defs/idArray"}, "segments": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/transcriptSegment"}}, "themes": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/transcriptTheme"}}}
    },
    "guidance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "metric", "period", "low", "high", "unit", "status", "claim_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "metric": {"type": "string"}, "period": {"type": "string"}, "low": {"type": ["number", "null"]}, "high": {"type": ["number", "null"]}, "unit": {"type": "string"}, "status": {"enum": ["introduced", "reaffirmed", "raised", "lowered", "withdrawn", "superseded"]}, "claim_id": {"$ref": "#/$defs/id"}}
    },
    "peer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "peer_instrument_id", "rationale", "methodology", "metric_ids", "evidence_document_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "peer_instrument_id": {"$ref": "#/$defs/id"}, "rationale": {"type": "string"}, "methodology": {"type": "string", "minLength": 1, "maxLength": 2000}, "metric_ids": {"$ref": "#/$defs/idArray"}, "evidence_document_ids": {"$ref": "#/$defs/idArray"}}
    },
    "factor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "factor", "direction", "magnitude", "value", "unit", "methodology", "methodology_version", "as_of_at", "prior_snapshot_id", "delta", "history_document_ids", "evidence_document_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "factor": {"type": "string"}, "direction": {"enum": ["positive", "negative", "mixed", "neutral"]}, "magnitude": {"enum": ["low", "moderate", "high", "unknown"]}, "value": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]}, "methodology": {"type": "string", "minLength": 1, "maxLength": 2000}, "methodology_version": {"type": "string", "minLength": 1, "maxLength": 128}, "as_of_at": {"$ref": "#/$defs/timestamp"}, "prior_snapshot_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "delta": {"type": ["number", "null"]}, "history_document_ids": {"$ref": "#/$defs/idArray"}, "evidence_document_ids": {"$ref": "#/$defs/idArray"}}
    },
    "valuationAssumption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "value", "unit", "metric_ids", "claim_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "metric_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}}
    },
    "valuationSensitivity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_assumption_id", "column_assumption_id", "fair_value", "calculation_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "row_assumption_id": {"$ref": "#/$defs/id"}, "column_assumption_id": {"$ref": "#/$defs/id"}, "fair_value": {"type": "number"}, "calculation_ids": {"$ref": "#/$defs/idArray"}}
    },
    "valuation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "methodology", "currency", "fair_value", "horizon", "input_metric_ids", "calculation_ids", "assumption_claim_ids", "assumptions", "sensitivity_cells"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"enum": ["bear", "base", "bull"]}, "methodology": {"type": "string"}, "currency": {"type": "string"}, "fair_value": {"type": "number"}, "horizon": {"type": "string"}, "input_metric_ids": {"$ref": "#/$defs/idArray"}, "calculation_ids": {"$ref": "#/$defs/idArray"}, "assumption_claim_ids": {"$ref": "#/$defs/idArray"}, "assumptions": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/valuationAssumption"}}, "sensitivity_cells": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/valuationSensitivity"}}}
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "kind": {"enum": ["issuer", "peer", "customer", "supplier", "partner", "regulator", "market", "other"]}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "occurred_at", "title", "status", "evidence_document_ids", "claim_ids", "entity_ids", "ripple_event_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "occurred_at": {"$ref": "#/$defs/timestamp"}, "title": {"type": "string"}, "status": {"enum": ["historical", "active", "scheduled", "cancelled"]}, "evidence_document_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "entity_ids": {"$ref": "#/$defs/idArray"}, "ripple_event_ids": {"$ref": "#/$defs/idArray"}}
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "probability", "impact", "thesis", "evidence_document_ids", "claim_ids", "trigger_metric_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "impact": {"enum": ["low", "moderate", "high", "severe", "unknown"]}, "thesis": {"type": "string"}, "evidence_document_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "trigger_metric_ids": {"$ref": "#/$defs/idArray"}}
    },
    "monitoring": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "cadence", "trigger", "consequence", "related_ids"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string"}, "cadence": {"type": "string"}, "trigger": {"type": "string"}, "consequence": {"type": "string"}, "related_ids": {"$ref": "#/$defs/idArray"}}
    },
    "priorOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "forecast_claim_id", "forecast_at", "evaluated_at", "result", "outcome_document_ids", "calibration_score", "notes"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "forecast_claim_id": {"$ref": "#/$defs/id"}, "forecast_at": {"$ref": "#/$defs/timestamp"}, "evaluated_at": {"$ref": "#/$defs/timestamp"}, "result": {"enum": ["confirmed", "partially_confirmed", "disconfirmed", "unresolved"]}, "outcome_document_ids": {"$ref": "#/$defs/idArray"}, "calibration_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "notes": {"type": "string"}}
    },
    "portfolioImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["thesis", "issuer_exposure_delta_percent", "sector_exposure_delta_percent", "diversification_effect", "risk_contribution", "metric_ids", "claim_ids", "non_executable"],
      "properties": {"thesis": {"type": "string"}, "issuer_exposure_delta_percent": {"type": ["number", "null"], "minimum": -100, "maximum": 100}, "sector_exposure_delta_percent": {"type": ["number", "null"], "minimum": -100, "maximum": 100}, "diversification_effect": {"enum": ["improves", "reduces", "neutral", "unknown"]}, "risk_contribution": {"enum": ["lower", "similar", "higher", "unknown"]}, "metric_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "non_executable": {"const": true}}
    },
    "evaluationCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "rubric", "evaluator", "evaluated_at", "document_ids", "claim_ids", "calculation_ids", "notes"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"enum": ["pass", "fail", "skipped", "unverified", "not_applicable"]}, "rubric": {"type": "string", "minLength": 1, "maxLength": 2000}, "evaluator": {"type": "string", "minLength": 1, "maxLength": 256}, "evaluated_at": {"$ref": "#/$defs/timestamp"}, "document_ids": {"$ref": "#/$defs/idArray"}, "claim_ids": {"$ref": "#/$defs/idArray"}, "calculation_ids": {"$ref": "#/$defs/idArray"}, "notes": {"type": "string"}}
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluator", "evaluator_provenance", "rubric_version", "checks", "limitations"],
      "properties": {"evaluator": {"type": "string", "minLength": 1, "maxLength": 256}, "evaluator_provenance": {"type": "string", "minLength": 1, "maxLength": 2000}, "rubric_version": {"type": "string", "minLength": 1, "maxLength": 128}, "checks": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/evaluationCheck"}}, "limitations": {"type": "array", "maxItems": 512, "items": {"type": "string"}}}
    },
    "researchDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_dossier_sha256", "added_document_ids", "changed_claim_ids", "changed_valuation_ids", "summary"],
      "properties": {"previous_dossier_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "added_document_ids": {"$ref": "#/$defs/idArray"}, "changed_claim_ids": {"$ref": "#/$defs/idArray"}, "changed_valuation_ids": {"$ref": "#/$defs/idArray"}, "summary": {"type": "string"}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
