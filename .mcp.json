{
  "mcpServers": {
    "tradingagents-portable": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=2.0,<3",
        "python",
        "-m",
        "tradingagents_portable.mcp_server"
      ],
      "cwd": ".",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "src"
      }
    }
  }
}
