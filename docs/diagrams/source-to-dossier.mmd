flowchart TB
  accTitle: Direct and portfolio evidence-to-dossier flows
  accDescr: A direct research-data capability calls one host SourcePort and returns one SourceBatch. An optional explicitly configured SourcePortfolioCollector calls at least two SourcePort routes and returns a SourcePortfolioReceipt while preserving separate batches, entitlements, attempts, and gaps. The caller derives terminal lineage from retained batches and declares decision-relevant gaps before StockResearchAgents performs domain-owned deterministic validation and completed-only publication.

  SRC["Public or entitled evidence<br/><small>filing · market · publisher · macro</small>"]

  subgraph DIRECT["Default direct capability route"]
    direction LR
    ADAPTER["Host provider adapter<br/><small>credentials · terms · pagination</small>"]
    PORT["SourcePort.fetch<br/><small>one capability + typed query</small>"]
    BATCH["SourceBatch<br/><small>one normalized bounded response</small>"]
    ADAPTER --> PORT --> BATCH
  end

  subgraph OPTIONAL["Optional portfolio route · registered only when configured"]
    direction LR
    COLLECT["SourcePortfolioCollector<br/><small>requires 2+ explicit routes</small>"]
    ROUTEA["SourcePort route A"]
    ROUTEB["SourcePort route B+"]
    BATCHES["Separate SourceBatch values<br/><small>no merged publishers or entitlements</small>"]
    RECEIPT["SourcePortfolioReceipt<br/><small>batches · attempts · gaps · duplicates</small>"]
    COLLECT --> ROUTEA --> BATCHES
    COLLECT --> ROUTEB --> BATCHES
    BATCHES --> RECEIPT
  end

  SRC --> ADAPTER
  SRC -. caller selects portfolio collection .-> COLLECT

  subgraph CALLER["Caller terminal assembly"]
    direction LR
    LINEAGE["Source lineage crosswalk<br/><small>batch identity · digest scope · entitlement</small>"]
    LIMIT["Declared limitations<br/><small>decision-relevant coverage gaps</small>"]
    SUBMIT["CompanyAnalyticsSubmissionV1<br/><small>dossier · claims · calculations · lineage</small>"]
    LINEAGE --> SUBMIT
    LIMIT --> SUBMIT
  end

  BATCH -->|derive retained-batch lineage| LINEAGE
  BATCHES -->|derive retained-batch lineage| LINEAGE
  RECEIPT -. sanitized gaps stay host-side .-> LIMIT

  subgraph CORE["StockResearchAgents core"]
    direction LR
    GATE{"Domain-owned deterministic validation<br/><small>time · references · licensing · calculations · safety</small>"}
    DONE[["CompanyAnalyticsResultV1<br/><small>atomic completed publication</small>"]]
    REJECT["Typed rejection<br/><small>no completed publication</small>"]
    GATE -->|accepted| DONE
    GATE -->|rejected| REJECT
  end

  SUBMIT --> GATE
  DONE --> READ["Completed-only readers<br/><small>RunView · viewer · JSON · Markdown · MCP</small>"]

  classDef host fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef port fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef validated fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef artifact fill:#ffffff,stroke:#1231a6,color:#071c26,stroke-width:3px;
  classDef rejected fill:#fff0ef,stroke:#b42318,color:#071c26,stroke-width:2px;
  class SRC,ADAPTER,COLLECT,RECEIPT host;
  class PORT,ROUTEA,ROUTEB,BATCH,BATCHES port;
  class LINEAGE,LIMIT,SUBMIT,GATE validated;
  class DONE artifact;
  class REJECT rejected;
  class READ port;
