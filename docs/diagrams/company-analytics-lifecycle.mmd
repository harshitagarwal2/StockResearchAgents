flowchart TB
  accTitle: Durable Company Analytics lifecycle
  accDescr: The coordinator fixes an execution mode before a run begins and accepts only the first incomplete stage. The host may do parallel preparation, but commits remain ordered. Each accepted commit creates a durable revision; pause and crash recovery resume from the first incomplete stage, while acknowledged cancellation is terminal. A valid terminal v4 submission enters a recoverable finalizing phase before canonical result publication.

  PLAN["Prepare request + 26-stage manifest<br/><small>roles · dependencies · output schemas</small>"]
  START(["Create PREPARED run<br/><small>request + fixed execution mode</small>"])
  RUN["Start RUNNING<br/><small>first stage becomes available</small>"]
  NEXT{"First incomplete stage"}

  WORK["Host executes current stage<br/><small>native agents, tools, or sequential fallback</small>"]
  ENVELOPE["Bounded stage envelope<br/><small>stage id + output references</small>"]
  COMMIT{"Validate ordered commit<br/><small>current stage · revision · output refs</small>"}
  SAVE["Persist SQLite/WAL revision<br/><small>checkpoint + lifecycle event</small>"]
  ALL{"All 26 stages committed?"}
  FINAL{"Validate terminal v4 bundle<br/><small>lineage · analytics · quality · safety</small>"}
  FINALIZING["FINALIZING<br/><small>stage result · quality · memory sidecars</small>"]
  PUBLISH[["Atomic completed publication<br/><small>RunResult artifacts + reports</small>"]]

  REJECT["Typed failure or unchanged state"]
  CANCEL["CANCELLED<br/><small>acknowledged cancellation is terminal</small>"]
  READ["Completed-only RunView<br/><small>viewer · exports · MCP</small>"]

  PLAN --> START --> RUN --> NEXT
  NEXT -->|stage 1–26| WORK --> ENVELOPE --> COMMIT
  COMMIT -->|accepted| SAVE --> ALL
  ALL -->|no: next stage| NEXT
  ALL -->|yes: finalize| FINAL
  COMMIT -->|rejected| REJECT
  FINAL -->|accepted| FINALIZING --> PUBLISH --> READ
  FINAL -->|rejected| REJECT
  SAVE -. pause or crash recovery resumes here .-> NEXT
  NEXT -. cancellation requested and acknowledged .-> CANCEL

  classDef host fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef port fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef durable fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef artifact fill:#ffffff,stroke:#1231a6,color:#071c26,stroke-width:3px;
  classDef rejected fill:#fff0ef,stroke:#b42318,color:#071c26,stroke-width:2px;
  classDef read fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  class WORK,ENVELOPE host;
  class START,PLAN,RUN,NEXT,COMMIT,ALL,FINAL port;
  class SAVE,FINALIZING durable;
  class PUBLISH artifact;
  class REJECT,CANCEL rejected;
  class READ read;
