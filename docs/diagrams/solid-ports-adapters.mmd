flowchart TB
  accTitle: SOLID ports-and-adapters architecture for Company Analytics
  accDescr: Harness-neutral caller adapters invoke StockResearchAgents coordination services. A separate stock-research-data MCP and caller-owned licensed adapters normalize evidence through SourcePort. Deterministic validation accepts only a complete CompanyAnalyticsSubmissionV1 before publishing CompanyAnalyticsResultV1 and projecting completed-result clients.

  subgraph H["Caller-owned mechanisms"]
    direction LR
    WEB["Web / browser / licensed providers"]
    DATA["Research-data MCP adapters<br/><small>implemented public tools · caller-owned</small>"]
    AGENT["Codex, generic agents,<br/>or supplied sequential executor"]
  end

  subgraph IN["Inbound adapters"]
    direction LR
    SKILL["Codex skill"]
    MCP["Coordination MCP<br/><small>no research-data tools</small>"]
    CLI["CLI / Python"]
  end

  subgraph APP["Application services"]
    direction LR
    PREP["Prepare analytics"]
    LIFE["run-control.v1"]
    IMPORT["Validate and publish"]
    OUTCOME["Append outcome"]
    CONFORM["Deterministic<br/>validation"]
  end

  subgraph DOMAIN["Domain and contracts"]
    direction LR
    Research["Embedded CompanyResearchSubmissionV1<br/>+ ResearchDossierV1"]
    Analytics["CompanyAnalyticsSubmissionV1"]
    ANALYTICS["Deterministic analytics"]
    QUALITY["Research Quality"]
    POLICY["Temporal, licensing, and safety policy"]
  end

  subgraph PORTS["Narrow outbound ports"]
    direction LR
    SOURCE["SourcePort.fetch(capability, typed query)"]
    RESULTS["Publication / result store"]
    QSTORE["Recoverable quality index"]
  end

  subgraph READ["Completed-only read side"]
    direction LR
    VIEW["RunView projection"]
    UI["CLI, MCP, exports, loopback viewer"]
  end

  WEB --> DATA
  DATA --> SOURCE
  AGENT --> SKILL
  SKILL --> PREP
  MCP --> PREP
  CLI --> PREP
  PREP --> Analytics
  PREP --> LIFE
  SOURCE --> AGENT
  AGENT --> LIFE
  LIFE --> IMPORT
  IMPORT --> Analytics
  Analytics --> Research
  Analytics --> ANALYTICS
  Analytics --> QUALITY
  POLICY --> Analytics
  IMPORT --> RESULTS
  RESULTS -. "reconstruct" .-> QSTORE
  OUTCOME --> QSTORE
  Analytics --> CONFORM
  RESULTS --> VIEW
  QSTORE --> VIEW
  VIEW --> UI

  classDef host fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef adapter fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef domain fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef port fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  class WEB,DATA,AGENT host;
  class SKILL,MCP,CLI,VIEW,UI adapter;
  class PREP,IMPORT,OUTCOME,CONFORM,Research,Analytics,ANALYTICS,QUALITY,POLICY domain;
  class SOURCE,RESULTS,QSTORE port;
