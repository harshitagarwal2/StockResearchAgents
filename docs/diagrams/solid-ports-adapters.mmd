flowchart TB
  accTitle: SOLID ports-and-adapters architecture for Company Analytics
  accDescr: Host retrieval adapters implement SourcePort outside the core; direct capability calls return one SourceBatch, while optional portfolio collection fans out across at least two routes and returns a separate SourcePortfolioReceipt. Inbound adapters use StockResearchApplication for completed reads, responses, cohort evaluation, and diagnostics, and use dedicated application command functions for plan, import, and lifecycle mutations. ApplicationRuntime composes focused ports, CompanyAnalyticsCoordinator, and CompletedPublicationSaga. Domain contracts own deterministic validation, and only completed results reach projections.

  subgraph REQUEST["Caller-owned request path"]
    direction LR
    PROVIDERS["Public / browser / licensed providers"]
    SOURCE["Host SourcePort<br/><small>one route → one SourceBatch</small>"]
    PORTFOLIO["Optional portfolio collector<br/><small>2+ routes → separate receipt</small>"]
    CALLER["Caller runtime<br/><small>terminal submission assembly</small>"]
    INBOUND["Inbound adapter<br/><small>harness · coordination MCP · CLI · Python</small>"]
    PROVIDERS --> SOURCE --> CALLER --> INBOUND
    SOURCE -. explicitly configured routes .-> PORTFOLIO --> CALLER
  end

  subgraph USECASES["Application boundary"]
    direction LR
    FACADE["StockResearchApplication<br/><small>completed reads · response · cohort · doctor</small>"]
    COMMANDS["Application command functions<br/><small>plan · import · lifecycle mutations</small>"]
    COORD["CompanyAnalyticsCoordinator<br/><small>lifecycle sequencing</small>"]
    QUERY["Completed query / response"]
    FACADE --> QUERY
    COMMANDS --> COORD
  end
  INBOUND --> FACADE
  INBOUND --> COMMANDS

  subgraph TRUTH["Domain-owned truth"]
    direction LR
    ANALYTICS["CompanyAnalyticsSubmissionV1"]
    RESEARCH["CompanyResearchSubmissionV1<br/>+ ResearchDossierV1"]
    CALC["Deterministic analytics"]
    QUALITY["Research Quality<br/><small>QualityScorecard · BinaryCalibrationReport</small>"]
    CONFORM{"Deterministic validation<br/><small>time · references · licensing · calculations · safety</small>"}
    ANALYTICS --> RESEARCH --> CONFORM
    ANALYTICS --> CALC --> CONFORM
    ANALYTICS --> QUALITY --> CONFORM
  end
  COMMANDS --> ANALYTICS

  subgraph PUBLICATION["Recoverable completed publication"]
    direction LR
    SAGA["CompletedPublicationSaga<br/><small>result · sidecar · memory ordering</small>"]
    RESULT[["CompanyAnalyticsResultV1<br/><small>completed source of truth</small>"]]
    READ["RunView · CLI · MCP · exports · loopback viewer"]
    SAGA --> RESULT --> READ
    RESULT --> QUERY --> READ
  end
  CONFORM --> SAGA

  subgraph INFRA["Focused ports, adapters, and state operations"]
    direction LR
    LAYOUT["StateLayout<br/><small>one durable root</small>"]
    RUNTIME["ApplicationRuntime<br/><small>constructs · injects · closes</small>"]
    PORTS["Focused ports<br/><small>lifecycle · result · quality · history</small>"]
    STORES["Durable adapters<br/><small>SQLite/WAL · atomic bundles · journals</small>"]
    OPS["State safety<br/><small>backup-first migration · redacted doctor</small>"]
    LAYOUT --> RUNTIME --> PORTS --> STORES
    LAYOUT -. inspect / adopt .-> OPS
  end

  RUNTIME -. injects .-> FACADE
  COORD --> PORTS
  SAGA --> PORTS
  STORES -. completed bundles .-> RESULT

  classDef host fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef adapter fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef domain fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef port fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  classDef artifact fill:#ffffff,stroke:#1231a6,color:#071c26,stroke-width:3px;
  class PROVIDERS,SOURCE,PORTFOLIO,CALLER host;
  class INBOUND,FACADE,COMMANDS,COORD,QUERY,SAGA adapter;
  class ANALYTICS,RESEARCH,CALC,QUALITY,CONFORM domain;
  class LAYOUT,RUNTIME,PORTS,STORES,OPS,READ port;
  class RESULT artifact;
