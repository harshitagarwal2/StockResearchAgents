flowchart TB
  accTitle: SOLID ports-and-adapters architecture for Company Analytics
  accDescr: Host-native harness adapters call portable application services. Implemented provider-neutral public research-data adapters and future licensed adapters normalize through SourcePort, while the pinned upstream executor remains a CI and development oracle until removal gates pass. Completed projections feed read-only clients.

  subgraph H["Host-owned mechanisms"]
    direction LR
    WEB["Web / browser / licensed providers"]
    DATA["Research-data MCP adapters<br/><small>implemented public tools · host-owned</small>"]
    AGENT["Codex, generic agents,<br/>or sequential host"]
    ORACLE["Pinned upstream oracle<br/>(CI / development)"]
  end

  subgraph IN["Inbound adapters"]
    direction LR
    SKILL["Codex skill"]
    MCP["MCP"]
    CLI["CLI / Python"]
  end

  subgraph APP["Application services"]
    direction LR
    PREP["Prepare analytics"]
    LIFE["Profile-driven lifecycle"]
    IMPORT["Validate and publish"]
    OUTCOME["Append outcome"]
    CONFORM["Semantic conformance<br/>and removal gates"]
  end

  subgraph DOMAIN["Domain and contracts"]
    direction LR
    V3["Frozen v3 dossier"]
    V4["V4 composition"]
    ANALYTICS["Deterministic analytics"]
    QUALITY["Research Quality"]
    POLICY["Temporal, licensing, and safety policy"]
  end

  subgraph PORTS["Narrow outbound ports"]
    direction LR
    SOURCE["SourcePort.fetch(capability, typed query)"]
    RESULTS["Publication / result store"]
    QSTORE["Recoverable quality index"]
  end

  subgraph READ["Completed-only read side"]
    direction LR
    VIEW["RunView projection"]
    UI["CLI, MCP, exports, loopback viewer"]
  end

  WEB --> DATA
  DATA --> SOURCE
  AGENT --> SKILL
  SKILL --> PREP
  MCP --> PREP
  CLI --> PREP
  PREP --> V4
  PREP --> LIFE
  SOURCE --> AGENT
  AGENT --> LIFE
  LIFE --> IMPORT
  IMPORT --> V4
  V4 --> V3
  V4 --> ANALYTICS
  V4 --> QUALITY
  POLICY --> V4
  IMPORT --> RESULTS
  RESULTS -. "reconstruct" .-> QSTORE
  OUTCOME --> QSTORE
  ORACLE -. "typed observable differential" .-> CONFORM
  V4 --> CONFORM
  RESULTS --> VIEW
  QSTORE --> VIEW
  VIEW --> UI

  classDef host fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef adapter fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef domain fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef port fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  class WEB,DATA,AGENT,ORACLE host;
  class SKILL,MCP,CLI,VIEW,UI adapter;
  class PREP,IMPORT,OUTCOME,CONFORM,V3,V4,ANALYTICS,QUALITY,POLICY domain;
  class SOURCE,RESULTS,QSTORE port;
