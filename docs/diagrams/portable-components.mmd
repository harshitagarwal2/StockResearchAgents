flowchart TB
  accTitle: StockResearchAgents component architecture
  accDescr: Inbound adapters call application coordinators. Strict domain contracts and specifications validate work. Outbound adapters persist completed state and present read-only projections.

  subgraph I["Inbound adapters"]
    direction LR
    CLI["CLI"]
    MCP["MCP server"]
    PY["Python API"]
    HOST["Host submission"]
  end

  subgraph A["Application core"]
    direction LR
    COORD["Research coordinators"]
    LIFE["Lifecycle state machine"]
    PUB["Publication service"]
  end

  subgraph D["Domain rules"]
    direction LR
    CONTRACT["Strict contracts"]
    SPEC["Conformance specifications"]
    QUALITY["Research Quality"]
  end

  subgraph O["Outbound adapters"]
    direction LR
    STORE["SQLite / WAL"]
    BUNDLE[["Atomic result bundles"]]
    VIEW["RunView projection"]
    UI["Research Dossier Viewer"]
  end

  CLI --> COORD
  MCP --> COORD
  PY --> COORD
  HOST --> COORD
  COORD --> LIFE
  LIFE --> CONTRACT
  CONTRACT --> SPEC
  QUALITY -. policy checks .-> SPEC
  SPEC --> PUB
  LIFE --> STORE
  PUB --> BUNDLE
  BUNDLE --> VIEW
  VIEW --> UI

  classDef inbound fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef app fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef domain fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef out fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  class CLI,MCP,PY,HOST inbound;
  class COORD,LIFE,PUB app;
  class CONTRACT,SPEC,QUALITY domain;
  class STORE,BUNDLE,VIEW,UI out;
