flowchart TB
  accTitle: StockResearchAgents component architecture
  accDescr: Inbound adapters call the StockResearchAgents application core. The public company-analytics.v1 profile composes an outer CompanyAnalyticsSubmissionV1 around an embedded CompanyResearchSubmissionV1 and ResearchDossierV1. Run-control.v1 coordinates durable state, while outbound adapters expose only completed projections.

  subgraph I["Inbound adapters"]
    direction LR
    CLI["CLI"]
    MCP["Coordination MCP"]
    PY["Python API"]
    HOST["CompanyAnalyticsSubmissionV1"]
  end

  subgraph A["Application core"]
    direction LR
    COORD["Research coordinators"]
    LIFE["run-control.v1"]
    PUB["Publication service"]
  end

  subgraph D["Domain rules"]
    direction LR
    CONTRACT["company-analytics.v1"]
    FOUNDATION["Embedded company-research.v1<br/><small>CompanyResearchSubmissionV1 · ResearchDossierV1</small>"]
    SPEC["Deterministic validation"]
    QUALITY["Research Quality"]
  end

  subgraph O["Outbound adapters"]
    direction LR
    STORE["SQLite / WAL"]
    BUNDLE[["Atomic result bundles"]]
    VIEW["RunView projection"]
    UI["Research Dossier Viewer"]
  end

  CLI --> COORD
  MCP --> COORD
  PY --> COORD
  HOST --> COORD
  COORD --> LIFE
  LIFE --> CONTRACT
  CONTRACT --> FOUNDATION --> SPEC
  QUALITY -. policy checks .-> SPEC
  SPEC --> PUB
  LIFE --> STORE
  PUB --> BUNDLE
  BUNDLE --> VIEW
  VIEW --> UI

  classDef inbound fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef app fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef domain fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef out fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  class CLI,MCP,PY,HOST inbound;
  class COORD,LIFE,PUB app;
  class CONTRACT,FOUNDATION,SPEC,QUALITY domain;
  class STORE,BUNDLE,VIEW,UI out;
