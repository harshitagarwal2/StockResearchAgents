flowchart TB
  accTitle: StockResearchAgents layered component architecture
  accDescr: CLI, MCP, and Python adapters use StockResearchApplication for completed reads, responses, cohort evaluation, and diagnostics, and use dedicated application command functions for plan, import, and lifecycle mutations. ApplicationRuntime composes the application from StateLayout and focused durable ports. CompanyAnalyticsCoordinator owns lifecycle sequencing and delegates recoverable completed publication to CompletedPublicationSaga. Contracts, deterministic analytics, and validation remain domain-owned. Completed bundles feed projection-only readers, while backup-first migration and redacted doctor remain operational paths.

  subgraph IN["Inbound adapters"]
    direction LR
    CLI["CLI"]
    MCP["Coordination MCP"]
    PY["Python API"]
  end

  subgraph COMPOSE["Composition root"]
    direction LR
    LAYOUT["StateLayout"]
    RUNTIME["ApplicationRuntime<br/><small>construct · inject · close</small>"]
    LAYOUT --> RUNTIME
  end

  subgraph APP["Application layer"]
    direction LR
    FACADE["StockResearchApplication<br/><small>completed reads · response · cohort · doctor</small>"]
    COMMANDS["Application command functions<br/><small>plan · import · lifecycle mutations</small>"]
    COORD["CompanyAnalyticsCoordinator<br/><small>run-control.v1 sequencing</small>"]
    SAGA["CompletedPublicationSaga<br/><small>recoverable publication order</small>"]
    QUERY["Completed query / response services"]
    FACADE --> QUERY
    COMMANDS --> COORD --> SAGA
  end

  subgraph DOMAIN["Domain layer"]
    direction LR
    CONTRACT["company-analytics.v1 contracts"]
    FOUNDATION["Embedded company-research.v1"]
    ANALYTICS["Deterministic analytics"]
    VALIDATE["Deterministic conformance<br/><small>temporal · referential · numerical · safety</small>"]
    QUALITY["Research Quality policy + evaluators"]
    CONTRACT --> FOUNDATION
    CONTRACT --> ANALYTICS
    CONTRACT --> QUALITY
    FOUNDATION --> VALIDATE
    ANALYTICS --> VALIDATE
    QUALITY --> VALIDATE
  end

  subgraph OUT["Focused ports and durable adapters"]
    direction LR
    LIFEPORT["LifecycleRepository<br/><small>validated LifecycleRecordV1</small>"]
    RESULTPORT["ResultPublicationPort"]
    QUALITYPORT["QualitySidecarPort"]
    MEMORYPORT["ResearchHistoryPort"]
    STORES["SQLite/WAL · atomic bundles<br/>quality journal · decision memory"]
    LIFEPORT --> STORES
    RESULTPORT --> STORES
    QUALITYPORT --> STORES
    MEMORYPORT --> STORES
  end

  subgraph READ["Completed-only projection"]
    direction LR
    RESULT[["CompanyAnalyticsResultV1"]]
    VIEW["RunView + reports"]
    UI["CLI · MCP · exports · loopback viewer"]
    RESULT --> VIEW --> UI
  end

  subgraph OPS["Operational state safety"]
    direction LR
    MIGRATE["Dry-run migration<br/><small>integrity check · backup first · atomic manifest</small>"]
    DOCTOR["Redacted read-only doctor<br/><small>health + bounded counts only</small>"]
  end

  CLI --> FACADE
  CLI --> COMMANDS
  MCP --> FACADE
  MCP --> COMMANDS
  PY --> FACADE
  PY --> COMMANDS
  RUNTIME --> FACADE
  RUNTIME --> LIFEPORT
  RUNTIME --> RESULTPORT
  RUNTIME --> QUALITYPORT
  RUNTIME --> MEMORYPORT
  COORD --> CONTRACT
  COMMANDS --> CONTRACT
  VALIDATE --> SAGA
  COORD --> LIFEPORT
  SAGA --> RESULTPORT
  SAGA --> QUALITYPORT
  SAGA --> MEMORYPORT
  RESULTPORT --> RESULT
  LAYOUT -. scoped state .-> MIGRATE
  LAYOUT -. scoped state .-> DOCTOR

  classDef inbound fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef app fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef domain fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef out fill:#ffffff,stroke:#516a75,color:#071c26,stroke-width:2px;
  classDef artifact fill:#ffffff,stroke:#1231a6,color:#071c26,stroke-width:3px;
  class CLI,MCP,PY inbound;
  class LAYOUT,RUNTIME,FACADE,COMMANDS,COORD,SAGA,QUERY app;
  class CONTRACT,FOUNDATION,ANALYTICS,VALIDATE,QUALITY domain;
  class LIFEPORT,RESULTPORT,QUALITYPORT,MEMORYPORT,STORES,VIEW,UI,MIGRATE,DOCTOR out;
  class RESULT artifact;
