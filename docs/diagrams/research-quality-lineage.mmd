flowchart TB
  accTitle: Research Quality per-forecast scoring and cohort calibration lineage
  accDescr: Forecasts are immutable artifacts of CompanyAnalyticsResultV1. Later outcome observations are append-only. QualityScorecard evaluates one forecast against its active resolved observation. Separately, BinaryCalibrationReport evaluates a caller-approved fixed historical binary cohort under cutoff, horizon, resolution-rule, distinct-instrument, and minimum-sample policies; it neither fits nor deploys a model and does not mutate completed results.

  subgraph IMMUTABLE["Immutable at completed publication"]
    direction LR
    POLICY["Research Quality policy<br/><small>version · digest · rules</small>"]
    FORECASTS["Forecast set<br/><small>issued at publication</small>"]
    RESULT[["CompanyAnalyticsResultV1<br/><small>seven authoritative artifacts</small>"]]
    POLICY --> RESULT
    FORECASTS --> RESULT
  end

  INDEX["Recoverable quality index<br/><small>derived from completed artifacts</small>"]
  RESULT --> INDEX

  subgraph LATER["Append-only later evidence"]
    direction LR
    OBS["Outcome observation"]
    CORR["Superseding correction"]
    ACTIVE["Active observation view"]
    OBS -. superseded by .-> CORR
    OBS --> ACTIVE
    CORR --> ACTIVE
  end
  INDEX --> ACTIVE

  subgraph SINGLE["Per-forecast evaluation"]
    direction LR
    ONE["One forecast + active outcome"]
    SCORE["score_forecast<br/><small>kind-specific deterministic rules</small>"]
    CARD[["QualityScorecard<br/><small>one forecast · metrics · limitations</small>"]]
    ONE --> SCORE --> CARD
  end
  FORECASTS --> ONE
  ACTIVE --> ONE

  subgraph COHORT["Separate evaluation-only cohort path"]
    direction LR
    CPOLICY["BinaryCalibrationPolicy<br/><small>cutoff · horizon · resolution · bins · min sample</small>"]
    FIXED["Fixed historical binary cohort<br/><small>distinct instruments · resolved pairs</small>"]
    CHECK["Leakage + policy checks<br/><small>reuses per-forecast scoring eligibility</small>"]
    REPORT[["BinaryCalibrationReport<br/><small>Brier · log loss · ECE · calibration bins</small>"]]
    CPOLICY --> CHECK
    FIXED --> CHECK --> REPORT
  end
  FORECASTS -. selected historical forecasts .-> FIXED
  ACTIVE -. resolved outcomes at cutoff .-> FIXED
  CARD -. eligibility semantics .-> CHECK

  NOMUTATE["Evaluation boundary<br/><small>no mutation · no fitting · no deployment</small>"]
  CARD -.-> NOMUTATE
  REPORT -.-> NOMUTATE

  classDef immutable fill:#eef3ff,stroke:#2257ff,color:#071c26,stroke-width:2px;
  classDef append fill:#fff4df,stroke:#ad6500,color:#071c26,stroke-width:2px;
  classDef derived fill:#e5f7f5,stroke:#00746e,color:#071c26,stroke-width:2px;
  classDef artifact fill:#ffffff,stroke:#1231a6,color:#071c26,stroke-width:3px;
  class POLICY,FORECASTS,RESULT immutable;
  class OBS,CORR,ACTIVE append;
  class INDEX,ONE,SCORE,CPOLICY,FIXED,CHECK,NOMUTATE derived;
  class CARD,REPORT artifact;
