flowchart TB
  accTitle: StockResearchAgents system context and authority boundaries
  accDescr: A caller runtime owns models, credentials, retrieval, and scheduling. The separate research-data MCP returns a direct SourceBatch by default and an optional SourcePortfolioReceipt only when a portfolio collector is explicitly configured. CLI, Python, and coordination MCP adapters call StockResearchApplication. ApplicationRuntime composes the coordinator and durable stores from StateLayout, while domain-owned deterministic validation and CompletedPublicationSaga gate completed publication.

  E["External evidence<br/><small>public or caller-entitled</small>"]
  H["Caller runtime<br/><small>models · credentials · entitlements · scheduling</small>"]

  subgraph HOST["Host retrieval boundary"]
    direction LR
    DATA["stock-research-data MCP"]
    DIRECT["Direct SourcePort<br/><small>default · one SourceBatch</small>"]
    PORTFOLIO["Optional SourcePortfolioCollector<br/><small>configured only · 2+ routes · receipt</small>"]
    DATA --> DIRECT
    DATA -. when explicitly configured .-> PORTFOLIO
  end

  E --> DATA
  DIRECT --> H
  PORTFOLIO --> H

  subgraph IN["Inbound adapters"]
    direction LR
    COORD["Coordination MCP"]
    CLI["CLI"]
    PY["Python API"]
  end
  H --> COORD
  H --> CLI
  H --> PY

  subgraph CORE["STOCKRESEARCHAGENTS · no credentials · no broker authority"]
    direction TB
    APP["StockResearchApplication<br/><small>transport-neutral facade</small>"]
    RUNTIME["ApplicationRuntime<br/><small>composition + resource lifetime</small>"]
    LAYOUT["StateLayout<br/><small>one durable root</small>"]
    LIFE["CompanyAnalyticsCoordinator<br/><small>run-control.v1 · validated LifecycleRecordV1</small>"]
    DOMAIN["Domain contracts + deterministic validation<br/><small>company-analytics.v1 · analytics · quality policy</small>"]
    SAGA["CompletedPublicationSaga<br/><small>recoverable result · sidecar · memory ordering</small>"]
    STORES["Durable adapters<br/><small>SQLite/WAL · atomic bundles · quality · memory</small>"]
    DONE[["CompanyAnalyticsResultV1<br/><small>completed source of truth</small>"]]
    LAYOUT --> RUNTIME
    RUNTIME --> APP
    RUNTIME --> LIFE
    RUNTIME --> STORES
    APP --> LIFE --> DOMAIN --> SAGA
    SAGA --> STORES
    SAGA --> DONE
  end

  COORD --> APP
  CLI --> APP
  PY --> APP

  OPS["State operations<br/><small>backup-first migration · redacted read-only doctor</small>"]
  OPS -. inspect / adopt .-> LAYOUT

  DONE --> U["Research Dossier Viewer<br/><small>completed only · read only</small>"]
  DONE --> X["Completed exports<br/><small>JSON · Markdown · MCP</small>"]

